# ─────────────────────────────────────────────────────────────
# MARAM · Landing de reserva — variables de entorno
# Copia este archivo a .env.local para desarrollo y replica los
# mismos valores en Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Medición (se inyecta en el HTML durante el build) ────────
# ID del Píxel de Meta. OPCIONAL: si no la defines se usa 28380442211594328,
# que es el que ya va en el código. Solo hace falta para cambiar de píxel.
# META_PIXEL_ID=28380442211594328

# Teléfono de WhatsApp, solo dígitos y con prefijo de país. OPCIONAL:
# si no la defines se usa 34698994566.
# WHATSAPP_PHONE=34698994566

# ── Canal 1: email de notificación vía Resend (recomendado) ──
# Clave de API de https://resend.com (plan gratuito: 3.000 emails/mes)
RESEND_API_KEY=
# Destinatario de los avisos. Admite varios separados por comas.
LEAD_TO_EMAIL=maram@marampsicologia.com
# Remitente. Debe ser de un dominio verificado en Resend.
# Mientras no verifiques el dominio puedes usar onboarding@resend.dev
LEAD_FROM_EMAIL=MARAM Landing <onboarding@resend.dev>
# Opcional: dirección de respuesta de los avisos
LEAD_REPLY_TO=

# ── Canal 2: webhook / Google Sheet (opcional, alternativo) ──
# URL del Web App de Google Apps Script (la que acaba en /exec).
# Es la ÚNICA variable que hace falta para que los leads lleguen a la hoja.
LEAD_WEBHOOK_URL=
